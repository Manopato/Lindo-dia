<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Va a gastar salchipapa</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      height: 100vh;
      background: linear-gradient(45deg, #ff4d6d, #ff80ab, #ff99c8, #ffc0cb);
      background-size: 600% 600%;
      animation: gradient 12s ease infinite;
      font-family: 'Arial', sans-serif;
      color: #fff;
      text-align: center;
      font-size: 24px;
      overflow: hidden;
      position: relative;
    }

    @keyframes gradient {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    .title {
      margin-top: 30px;
      font-size: 3em;
      font-weight: bold;
      color: #ffffff;
      text-shadow: 0 0 15px #000;
      margin-bottom: 10px;
    }

    .image-container {
      margin-bottom: 30px;
    }

    .image-container img {
      max-width: 95vw;
      max-height: 500px;
      border-radius: 15px;
      box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
    }

    .buttons {
      position: relative;
      margin-top: 10px;
    }

    button {
      background-color: #00ffcc;
      color: #000;
      border: none;
      padding: 20px 40px;
      margin: 10px;
      font-size: 1.2em;
      cursor: pointer;
      border-radius: 10px;
      box-shadow: 0 0 15px #00ffcc;
      transition: all 0.3s ease;
      position: relative;
    }

    #dateInput {
      margin-top: 30px;
      display: none;
    }

    input[type="date"] {
      padding: 12px;
      border-radius: 6px;
      border: none;
      font-size: 1.2em;
    }

    a {
      display: inline-block;
      margin-top: 25px;
      background-color: #25D366;
      color: white;
      text-decoration: none;
      padding: 12px 24px;
      border-radius: 10px;
      font-size: 1.2em;
      box-shadow: 0 0 10px #25D366;
    }

    .no-button {
      position: absolute;
    }
  </style>
</head>
<body>
  <div class="title">Va a gastar salchipapa</div>

  <div class="image-container">
    <!-- Imagen de salchipapa -->
    <img src="https://i.pinimg.com/736x/1a/10/43/1a1043709de6f5e6dbfe57d440d07029.jpg" alt="Salchipapa">
  </div>

  <div class="buttons">
    <button onclick="mostrarFecha()">Sí</button>
    <button class="no-button" id="noBtn" onclick="moverBoton()">No</button>
  </div>

  <div id="dateInput">
    <p>Elige una fecha:</p>
    <input type="date" id="fecha">
    <br>
    <a id="whatsappLink" href="#" target="_blank">Enviar por WhatsApp</a>
  </div>

  <script>
    function mostrarFecha() {
      document.getElementById('dateInput').style.display = 'block';
      const fechaInput = document.getElementById('fecha');
      const link = document.getElementById('whatsappLink');
      fechaInput.addEventListener('change', () => {
        const fecha = fechaInput.value;
        const mensaje = `Vamos a gastar salchipapa el ${fecha}`;
        link.href = `https://wa.me/573017004532?text=${encodeURIComponent(mensaje)}`;
      });
    }

    function moverBoton() {
      const btn = document.getElementById('noBtn');
      const maxX = window.innerWidth - btn.offsetWidth;
      const maxY = window.innerHeight - btn.offsetHeight;
      const x = Math.floor(Math.random() * maxX);
      const y = Math.floor(Math.random() * maxY);
      btn.style.left = `${x}px`;
      btn.style.top = `${y}px`;
    }
  </script>
</body>
</html>
